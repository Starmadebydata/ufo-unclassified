{
	"compatibility_date": "2026-05-09",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "ufo-declassified",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The worker must see every request so www can 301 before an asset is served.
		"run_worker_first": true,
		// Production already serves src/pages/404.astro for unknown paths.
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "ufo-declassified-media"
		}
	]
}
