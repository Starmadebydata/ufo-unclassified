---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoBrowser from '../../components/VideoBrowser.tsx';
import { getVideoEntries, RELEASES, RELEASE_COLORS } from '../../data/toolData';

const videos = getVideoEntries();
---
<BaseLayout
  title="UAP Video Browser"
  description={`Browse all ${videos.length} declassified UAP videos from PURSUE Releases 01-04 in one place: Lake Huron shootdown, Syrian instant acceleration, CENTCOM encounters, and more, with links to records and official sources.`}
>
  <section class="container-narrow py-12">
    <div class="section-header">
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white uppercase tracking-wider">UAP Video Browser</h1>
    </div>
    <p class="text-space-400 mb-2 text-sm font-mono max-w-3xl">
      Every video in the archive on one page. Filter by release or agency, click to play, then follow the links to the
      full record and the official source.
    </p>
    <p class="text-space-500 mb-8 text-xs font-mono max-w-3xl">
      Caution: these are public renditions released through official channels, not raw sensor files. Most carry official
      chain-of-custody caveats, and a clip alone rarely contains enough context to identify what it shows.
    </p>

    <VideoBrowser client:load videos={videos} releases={RELEASES} releaseColors={RELEASE_COLORS} />

    <div class="mt-12 doc-card p-6">
      <h2 class="font-display text-sm font-bold text-white uppercase tracking-wider mb-3">Watching responsibly</h2>
      <ul class="space-y-2 text-xs text-space-300 font-mono leading-relaxed">
        <li>// "Unidentified" in a caption means the reporting unit could not identify it — not that no one can.</li>
        <li>// Infrared footage compresses depth and size cues; small nearby objects can read as large distant ones.</li>
        <li>// The most-shared clips are the most visually striking, which is not the same as the most evidentially strong.</li>
      </ul>
      <p class="text-xs text-space-400 font-mono mt-4">
        Context for the most-discussed clips:
        <a href="/blog/lake-huron-uap-video-release-02-analysis/" class="text-cyan-bright hover:underline">Lake Huron shootdown</a> ·
        <a href="/blog/syrian-uap-instant-acceleration-release-02-analysis/" class="text-cyan-bright hover:underline">Syrian instant acceleration</a> ·
        <a href="/blog/military-uap-videos-pentagon-released/" class="text-cyan-bright hover:underline">Pentagon video overview</a>
      </p>
    </div>
  </section>
</BaseLayout>
