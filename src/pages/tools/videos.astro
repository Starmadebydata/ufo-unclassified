---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoBrowser from '../../components/VideoBrowser.tsx';
import { getVideoEntries, RELEASES, RELEASE_COLORS, RELEASE_RANGE_LABEL } from '../../data/toolData';
import { makeArchiveDatasetSchema, SITE_NAME } from '../../config';

const videos = getVideoEntries();
const siteUrl = Astro.site?.href || 'https://ufo-declassified.com/';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const videosJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: `Declassified UAP & UFO Video Browser — ${SITE_NAME}`,
      url: canonicalUrl,
      applicationCategory: 'ReferenceApplication',
      operatingSystem: 'Any',
      isAccessibleForFree: true,
      description: `Browse and filter all ${videos.length} declassified U.S. government UAP/UFO videos from PURSUE ${RELEASE_RANGE_LABEL}, with direct links to official source records.`,
      publisher: { '@type': 'Organization', name: SITE_NAME, url: siteUrl },
    },
    makeArchiveDatasetSchema(siteUrl),
  ],
};
---
<BaseLayout
  title="Declassified UAP & UFO Video Browser"
  description={`Watch and filter all ${videos.length} declassified UAP & UFO videos from PURSUE ${RELEASE_RANGE_LABEL}: 1952 Tremonton film, Lake Huron, CENTCOM encounters, and source records.`}
  ogImage="/blog-assets/tool-og-videos.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(videosJsonLd)} slot="head" />
  <section class="container-narrow py-12">
    <div class="section-header">
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white uppercase tracking-wider">UAP Video Browser</h1>
    </div>
    <p class="text-space-400 mb-2 text-sm font-mono max-w-3xl">
      Every video in the archive on one page. Filter by release or agency, click to play, then follow the links to the
      full record and the official source.
    </p>
    <p class="text-space-500 mb-8 text-xs font-mono max-w-3xl">
      Caution: these are public renditions released through official channels, not raw sensor files. Most carry official
      chain-of-custody caveats, and a clip alone rarely contains enough context to identify what it shows.
    </p>

    <VideoBrowser client:load videos={videos} releases={RELEASES} releaseColors={RELEASE_COLORS} />

    <div class="mt-12 doc-card p-6">
      <h2 class="font-display text-sm font-bold text-white uppercase tracking-wider mb-3">Watching responsibly</h2>
      <ul class="space-y-2 text-xs text-space-300 font-mono leading-relaxed">
        <li>// "Unidentified" in a caption means the reporting unit could not identify it — not that no one can.</li>
        <li>// Infrared footage compresses depth and size cues; small nearby objects can read as large distant ones.</li>
        <li>// The most-shared clips are the most visually striking, which is not the same as the most evidentially strong.</li>
      </ul>
      <div class="mt-6 pt-5 border-t border-space-800/80">
        <h3 class="font-display text-xs font-bold text-cyan-bright uppercase tracking-wider mb-3">Featured Video Analysis &amp; Living Case Files</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href="/topics/tremonton-utah-ufo-film-1952/" class="rounded border border-space-700/60 bg-space-950/60 p-3.5 hover:border-cyan-glow/50 transition-colors group">
            <span class="text-[9px] font-mono uppercase tracking-wider text-cyan-bright">Living Case File</span>
            <div class="text-xs font-semibold text-white group-hover:text-cyan-bright mt-1">1952 Tremonton, Utah UFO Film</div>
          </a>
          <a href="/topics/triangular-uap-case-file/" class="rounded border border-space-700/60 bg-space-950/60 p-3.5 hover:border-cyan-glow/50 transition-colors group">
            <span class="text-[9px] font-mono uppercase tracking-wider text-cyan-bright">Living Case File</span>
            <div class="text-xs font-semibold text-white group-hover:text-cyan-bright mt-1">Triangular UAP Case File (2002–2026)</div>
          </a>
          <a href="/blog/military-uap-videos-pentagon-released/" class="rounded border border-space-700/60 bg-space-950/60 p-3.5 hover:border-cyan-glow/50 transition-colors group">
            <span class="text-[9px] font-mono uppercase tracking-wider text-space-400">Analysis</span>
            <div class="text-xs font-semibold text-white group-hover:text-cyan-bright mt-1">28 Military UAP Videos — What They Show</div>
          </a>
          <a href="/blog/lake-huron-uap-video-release-02-analysis/" class="rounded border border-space-700/60 bg-space-950/60 p-3.5 hover:border-cyan-glow/50 transition-colors group">
            <span class="text-[9px] font-mono uppercase tracking-wider text-space-400">Release 02</span>
            <div class="text-xs font-semibold text-white group-hover:text-cyan-bright mt-1">Lake Huron UAP Video Analysis</div>
          </a>
          <a href="/blog/syrian-uap-instant-acceleration-release-02-analysis/" class="rounded border border-space-700/60 bg-space-950/60 p-3.5 hover:border-cyan-glow/50 transition-colors group">
            <span class="text-[9px] font-mono uppercase tracking-wider text-space-400">Release 02</span>
            <div class="text-xs font-semibold text-white group-hover:text-cyan-bright mt-1">Syrian Instant Acceleration Clip</div>
          </a>
          <a href="/blog/northeastern-red-orb-release-03-analysis/" class="rounded border border-space-700/60 bg-space-950/60 p-3.5 hover:border-cyan-glow/50 transition-colors group">
            <span class="text-[9px] font-mono uppercase tracking-wider text-space-400">Release 03</span>
            <div class="text-xs font-semibold text-white group-hover:text-cyan-bright mt-1">Northeastern Red Orb: Video vs Identification</div>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
