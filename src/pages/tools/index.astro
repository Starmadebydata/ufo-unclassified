---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolDocs, getMapLocations, getVideoEntries } from '../../data/toolData';
import { trackedClaims } from '../../data/claims';

const docs = getToolDocs();
const { locations } = getMapLocations();
const mappedDocs = locations.reduce((sum, l) => sum + l.docs.length, 0);
const videoCount = getVideoEntries().length;

const tools = [
  {
    href: '/tools/map',
    title: 'UAP Sighting Map',
    tagline: `${mappedDocs} records placed on an interactive world map`,
    description: 'Every mappable record in the archive, grouped by reported location, colored by release, with honest precision labels for broad-region records.',
    icon: 'M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11z M12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  },
  {
    href: '/tools/compare',
    title: 'Release Comparator',
    tagline: 'Any two PURSUE tranches, side by side',
    description: 'Agency mix, file formats, event years, and location clusters per release — built to end the cumulative-versus-new-files confusion.',
    icon: 'M9 3v18 M15 3v18 M3 9h6 M3 15h6 M15 9h6 M15 15h6',
  },
  {
    href: '/tools/stats',
    title: 'Archive Statistics',
    tagline: `${docs.length} records in numbers`,
    description: 'The whole archive at a glance: per-release, per-agency, per-format, and per-decade breakdowns, recomputed on every site build.',
    icon: 'M3 21h18 M6 21V10 M11 21V4 M16 21v-7 M21 21V8',
  },
  {
    href: '/tools/videos',
    title: 'Video Browser',
    tagline: `All ${videoCount} archive videos in one place`,
    description: 'Filterable gallery of every released clip with in-page playback, record links, official source links, and standing chain-of-custody cautions.',
    icon: 'M4 5h16v14H4z M10 9l5 3-5 3z',
  },
  {
    href: '/tools/claims',
    title: 'Claim Tracker',
    tagline: `${trackedClaims.length} public claims under watch`,
    description: 'Who claimed what, its current verification status, and what evidence would settle it — from the 1952 tape to the contractor loophole.',
    icon: 'M9 11l3 3 8-8 M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9',
  },
];
---
<BaseLayout
  title="Research Tools"
  description="Interactive research tools for the PURSUE UAP archive: sighting map, release comparator, and archive statistics across all declassified document tranches."
>
  <section class="container-narrow py-12">
    <div class="section-header">
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white uppercase tracking-wider">Research Tools</h1>
    </div>
    <p class="text-space-400 mb-10 text-sm font-mono max-w-3xl">
      Interactive instruments built on top of the document archive. Same data as the
      <a href="/documents" class="text-cyan-bright hover:underline">document database</a> — different ways to see it.
    </p>

    <div class="grid md:grid-cols-3 gap-5">
      {tools.map(tool => (
        <a href={tool.href} class="doc-card p-6 group flex flex-col">
          <svg class="w-8 h-8 text-cyan-glow group-hover:text-cyan-bright transition-colors mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d={tool.icon} />
          </svg>
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider group-hover:text-cyan-bright transition-colors">{tool.title}</h2>
          <div class="text-[10px] font-mono text-cyan-glow/70 uppercase tracking-widest mt-1 mb-3">{tool.tagline}</div>
          <p class="text-xs text-space-300 font-mono leading-relaxed flex-1">{tool.description}</p>
          <div class="text-[10px] font-mono text-space-500 uppercase tracking-widest mt-4 group-hover:text-cyan-bright transition-colors">Open tool →</div>
        </a>
      ))}
    </div>

    <div class="mt-12 doc-card p-6">
      <h2 class="font-display text-sm font-bold text-white uppercase tracking-wider mb-3">Why tools, not just documents</h2>
      <p class="text-xs text-space-300 font-mono leading-relaxed max-w-3xl">
        Individual records answer "what does this file say." Tools answer "what does the archive look like" — where reports
        cluster, how each release differs, which agencies contribute what. Patterns are not proof, but they are better
        questions. Every number here links back to the underlying records so you can check the source yourself.
      </p>
    </div>
  </section>
</BaseLayout>
