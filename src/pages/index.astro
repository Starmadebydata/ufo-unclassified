---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.tsx';
import { documents, getFeaturedDocuments, getAllYears } from '../data/documents';
import { AGENCY_INFO, CATEGORY_INFO } from '../data/types';
import type { Agency } from '../data/types';
import { fileThumbnailUrl } from '../config';
import { cultureItems } from '../data/culture';

const searchDocs = documents.map(d => ({
  slug: d.slug,
  title: d.title,
  agency: d.agency,
  category: d.category,
  year: d.year,
  location: d.location?.name || '',
  summary: d.summary,
  release: d.releaseLabel || 'Release 01',
}));

const featured = getFeaturedDocuments();
const totalDocs = documents.length;
const totalFiles = documents.reduce((sum, d) => sum + d.files.length, 0);
const agencies = Object.keys(AGENCY_INFO) as Agency[];
const agencyCounts = agencies.reduce((acc, a) => {
  acc[a] = documents.filter(d => d.agency === a).length;
  return acc;
}, {} as Record<string, number>);
const agencyList = agencies.filter(a => agencyCounts[a] > 0);
const governmentAgencyCount = agencyList.filter(a => a !== 'OTHER').length;
const years = getAllYears();
const earliestYear = years.length ? Math.min(...years) : null;
const latestYear = years.length ? Math.max(...years) : null;
const yearRange = earliestYear && latestYear ? `${earliestYear}-${latestYear}` : '80+ years';
const videoDocs = documents.filter(d => d.files.some(f => f.type === 'video'));
const audioDocs = documents.filter(d => d.files.some(f => f.type === 'audio'));
const imageDocs = documents.filter(d => d.files.some(f => f.type === 'image'));
const release05Docs = documents.filter(d => (d.releaseLabel || 'Release 01') === 'Release 05');
const release05Files = release05Docs.reduce((sum, d) => sum + d.files.length, 0);
const release05VideoDocs = release05Docs.filter(d => d.files.some(f => f.type === 'video')).length;
const release05ImageDocs = release05Docs.filter(d => d.files.some(f => f.type === 'image')).length;
const release05PdfDocs = release05Docs.filter(d => d.files.some(f => f.type === 'pdf')).length;
const searchSuggestions = ['Apollo 12 UFO', 'Apollo 12 transcript', 'Apollo 17 UAP', '65 HS1 834228961', 'DOW UAP PR46'];

function documentPreviewUrl(doc: any): string | undefined {
  const imageFile = doc.files.find((file: any) => file.type === 'image');
  if (imageFile) return fileThumbnailUrl(imageFile);
  const mediaFile = doc.files.find((file: any) => (file.type === 'video' || file.type === 'audio') && file.thumbnailUrl);
  return mediaFile ? fileThumbnailUrl(mediaFile) : undefined;
}

function primaryFileType(doc: any): string {
  if (doc.files.some((file: any) => file.type === 'video')) return 'video';
  if (doc.files.some((file: any) => file.type === 'audio')) return 'audio';
  if (doc.files.some((file: any) => file.type === 'pdf')) return 'pdf';
  return 'image';
}

function fileIconClass(type: string): string {
  if (type === 'pdf') return 'file-icon-pdf';
  if (type === 'video') return 'file-icon-video';
  if (type === 'audio') return 'file-icon-audio';
  return 'file-icon-image';
}

const entryPoints = [
  {
    href: '/documents/',
    label: 'Full Database',
    title: 'Search every record',
    body: `Open the complete archive with ${totalDocs} document records and filters for agency, file type, year, and category.`,
    meta: `${totalFiles} files indexed`,
  },
  {
    href: '/topics/',
    label: 'Research Topics',
    title: 'Start from a guide',
    body: 'Use curated paths for FBI files, NASA Apollo records, Pentagon UAP videos, historical records, and the PURSUE release.',
    meta: 'Citation-ready topic pages',
  },
  {
    href: '/agencies/',
    label: 'By Agency',
    title: 'Follow the source',
    body: 'Start from Department of War, FBI, NASA, DOE, CIA, ODNI, State Department, National Archives, or other public sources.',
    meta: `${agencyList.length} source groups`,
  },
  {
    href: '/coverage/',
    label: 'Coverage',
    title: 'Read the outside reports',
    body: 'Review media coverage and source commentary around the PURSUE release without leaving the archive flow.',
    meta: 'Press and public context',
  },
  {
    href: '/culture/',
    label: 'Films & Reports',
    title: 'Track the public imagination',
    body: 'Explore UFO films, TV series, documentaries, journalism, official reports, and public hearings from around the world.',
    meta: `${cultureItems.length} cultural signals`,
  },
  {
    href: '/timeline/',
    label: 'Timeline',
    title: 'Scan by year',
    body: 'Move through the archive chronologically to see older case files, space-era material, and recent releases together.',
    meta: yearRange,
  },
];

const trendingSearches = [
  {
    href: '/topics/nasa-apollo-ufo-material/',
    query: 'apollo 12 ufo',
    title: 'Apollo 12 UFO Files',
    body: 'Start with the Apollo topic hub, then jump into the Apollo 12 transcript, visual media, and Apollo 17 comparison records.',
    meta: 'NASA transcript and lunar image set',
  },
  {
    href: '/documents/nasa-uap-d1-apollo-12-transcript-1969/',
    query: 'apollo 12 transcript',
    title: 'Apollo 12 Mission Transcript',
    body: 'Open the primary NASA transcript page for Apollo 12 mission communications and anomalous-observation context.',
    meta: 'Primary transcript record',
  },
  {
    href: '/documents/nasa-uap-vm6-apollo-17-1972/',
    query: 'apollo 17 uap',
    title: 'Apollo 17 Visual Media VM6',
    body: 'Review the Apollo 17 image record beside the Apollo 17 transcript and crew debriefing pages.',
    meta: 'Apollo 17 image record',
  },
  {
    href: '/documents/65-hs1-834228961-62-hq-83894-section-10/',
    query: '65 hs1 834228961',
    title: 'FBI 62-HQ-83894 Section 10',
    body: 'Go directly to the FBI 65-HS1 / 62-HQ-83894 record with image and PDF files in the public archive.',
    meta: 'FBI case-file series',
  },
  {
    href: '/documents/1006106-dow-uap-pr46-unresolved-uap-report-indopacom-2024/',
    query: 'dow-uap-pr46',
    title: 'DOW-UAP-PR46 INDOPACOM 2024',
    body: 'Open the public Department of War PR46 video source page for the unresolved INDOPACOM UAP report.',
    meta: 'UAP video source page',
  },
  {
    href: '/documents/1006073-dow-uap-pr28-unresolved-uap-report-greece-january-2024/',
    query: 'uappr28',
    title: 'DOW-UAP-PR28 Greece 2024',
    body: 'Review the Department of War PR28 video source page tied to the Greece January 2024 UAP report.',
    meta: 'UAP video source page',
  },
];
---
<BaseLayout title="Home">
  <section class="landing-hero relative overflow-hidden flex items-center">
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img 
        src="/hero-bg.png" 
        alt="" 
        class="w-full h-full object-cover object-center scale-110 blur-[2px]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-space-950/82 via-space-950/58 to-space-950/96"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-space-950/72 via-transparent to-space-950/72"></div>
    </div>
    <div class="absolute inset-0 hero-grid opacity-20 z-[1]"></div>
    <div class="absolute inset-0 z-[1] pointer-events-none" style="background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.02) 3px, rgba(0,0,0,0.02) 6px);"></div>
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-[2]" aria-hidden="true">
      <div class="absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-glow/40 to-transparent" style="animation: scanDown 8s linear infinite;"></div>
    </div>

    <div class="container-narrow relative z-10 py-10 md:py-24">
      <div class="mx-auto max-w-4xl text-center fade-up">
        <div class="mb-5 md:mb-7 inline-block">
          <span class="stamp-declassified">DECLASSIFIED — MAY 2026</span>
        </div>

        <a href="/documents/?release=Release%2005" class="release-alert mx-auto mb-5 md:mb-7" aria-label="Open War.gov Release 05 UFO files">
          <span class="release-alert__marker">Release 05</span>
          <span class="release-alert__text">
            <strong>War.gov published the fifth UFO file release.</strong>
            <span>{release05Docs.length} new records are now indexed.</span>
          </span>
          <span class="release-alert__cta">Open batch →</span>
        </a>

        <a href="/blog/dow-nda-waiver-pursue-whistleblower-pipeline/" class="news-alert mx-auto mb-5 md:mb-7" aria-label="Read the analysis of DOW's September 14 NDA waiver for PURSUE">
          <span class="news-alert__marker">Sep 14</span>
          <span class="news-alert__text">
            <strong>DOW issued a legal waiver for UAP disclosures to PURSUE.</strong>
            <span>Here is what the NDA/SAPIA waiver actually covers — and doesn't.</span>
          </span>
          <span class="news-alert__cta">Read the analysis →</span>
        </a>

        <h1 class="font-display text-3xl md:text-5xl lg:text-6xl font-black text-white leading-[1.12] mb-5 md:mb-6 tracking-wide uppercase glitch-text">
          Search the UFO Files<br class="hidden sm:block"/>
          <span class="glow-red">Release 05 Now Indexed</span>
        </h1>

        <p class="text-base md:text-lg text-space-100 leading-relaxed mb-6 md:mb-8 max-w-2xl mx-auto font-light">
          Search <strong class="text-white font-semibold">{totalDocs} document records</strong> and <strong class="text-white font-semibold">{totalFiles} files</strong>, including War.gov's fifth public UAP release from August 7, 2026.
        </p>

        <div class="flex flex-wrap justify-center gap-5 md:gap-10 mb-7 md:mb-9">
          {[
            { val: totalDocs, label: 'Records' },
            { val: totalFiles, label: 'Files' },
            { val: videoDocs.length, label: 'Videos' },
            { val: audioDocs.length, label: 'Audio' },
            { val: governmentAgencyCount, label: 'Agencies' },
          ].map((stat, i) => (
            <div class="text-center group" style={`animation: fadeUp 0.5s ease-out ${i * 0.1}s both;`}>
              <div class="text-xl md:text-3xl font-display font-black text-white tracking-wider group-hover:text-cyan-bright transition-colors">{stat.val}</div>
              <div class="text-[10px] font-mono text-space-300 uppercase tracking-[0.18em] mt-1">{stat.label}</div>
            </div>
          ))}
        </div>

        <div class="mb-5 md:mb-7">
          <SearchBar client:load documents={searchDocs} suggestedQueries={searchSuggestions} />
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/documents/?release=Release%2005" class="release02-action inline-flex items-center justify-center gap-2 px-8 py-3 font-mono font-bold text-xs tracking-wider uppercase rounded transition-all" id="cta-release-05">
            View Release 05 Files →
          </a>
          <a href="/documents/" class="primary-action inline-flex items-center justify-center gap-2 px-8 py-3 bg-cyan-glow/95 hover:bg-cyan-bright text-space-950 font-mono font-bold text-xs tracking-wider uppercase rounded transition-all hover:shadow-lg hover:shadow-cyan-glow/25" id="cta-browse">
            Browse Full Database →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-narrow pt-10 pb-4">
    <div class="release02-briefing">
      <div class="release02-copy">
        <div class="release02-eyebrow">New public release · August 7, 2026</div>
        <h2>War.gov Release 05 adds a fifth batch of UFO files</h2>
        <p>
          The new batch adds 16 Department of War UAP videos plus a first set of FBI FD-302 witness interviews with digital renderings, the 1953 Naval film analysis of the Great Falls and Tremonton footage, 1947-1948 Air Materiel Command and ghost-rocket records, CIA Puerto Rico material, and 1963 State Department cables on the Bahia, Brazil incident. Release 05 is indexed across the site so it stands apart from the earlier batches.
        </p>
        <div class="release02-links">
          <a href="/documents/?release=Release%2005">Browse Release 05</a>
          <a href="/topics/pursue-release-05/">Open the topic guide</a>
        </div>
      </div>
      <div class="release02-metrics" aria-label="Release 05 file summary">
        {[
          { value: release05Docs.length, label: 'Records' },
          { value: release05Files, label: 'Files' },
          { value: release05VideoDocs, label: 'Videos' },
          { value: release05ImageDocs, label: 'Images' },
          { value: release05PdfDocs, label: 'PDFs' },
        ].map(item => (
          <div class="release02-metric">
            <span>{item.value}</span>
            <small>{item.label}</small>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-narrow py-10">
    <div class="status-strip grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded border border-cyan-glow/18 bg-cyan-glow/10">
      {[
        { label: 'Source', value: 'war.gov/UFO', detail: 'Public government release' },
        { label: 'Indexed', value: `${totalFiles} files`, detail: `${totalDocs} searchable records` },
        { label: 'Coverage', value: `${imageDocs.length} image sets`, detail: `${videoDocs.length} video and ${audioDocs.length} audio records` },
        { label: 'Updated', value: 'August 7, 2026', detail: `${release05Docs.length} Release 05 records added` },
      ].map(item => (
        <div class="bg-space-900/95 p-5">
          <div class="text-[10px] font-mono uppercase tracking-[0.22em] text-space-300">{item.label}</div>
          <div class="mt-2 font-display text-lg font-bold text-white">{item.value}</div>
          <div class="mt-1 text-xs font-mono text-space-300">{item.detail}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="section-header">
      <h2 class="font-display text-lg md:text-xl font-bold text-white uppercase tracking-wider">Trending Search Paths</h2>
    </div>
    <p class="text-space-300 mb-8 text-sm font-mono">Fast routes into the records people are already searching for.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {trendingSearches.map(item => (
        <a href={item.href} class="doc-card p-5 group cursor-pointer">
          <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-amber-bright">{item.query}</div>
          <h3 class="mt-4 font-display text-base font-bold text-white group-hover:text-cyan-bright transition-colors">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-space-200">{item.body}</p>
          <div class="mt-5 text-[10px] font-mono uppercase tracking-[0.16em] text-space-300">{item.meta}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="section-header">
      <h2 class="font-display text-lg md:text-xl font-bold text-white uppercase tracking-wider">Start Here</h2>
    </div>
    <p class="text-space-300 mb-8 text-sm font-mono">Choose the fastest route into the archive.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
      {entryPoints.map(item => (
        <a href={item.href} class="doc-card p-5 group cursor-pointer">
          <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-cyan-bright">{item.label}</div>
          <h3 class="mt-4 font-display text-base font-bold text-white group-hover:text-cyan-bright transition-colors">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-space-200">{item.body}</p>
          <div class="mt-5 text-[10px] font-mono uppercase tracking-[0.16em] text-space-300">{item.meta}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="section-header">
      <h2 class="font-display text-lg md:text-xl font-bold text-white uppercase tracking-wider">Source Agencies</h2>
    </div>
    <p class="text-space-300 mb-8 text-sm font-mono">Documents organized by releasing government agency.</p>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      {agencyList.map(agency => (
        <a href={`/agencies/${agency.toLowerCase()}/`} class="doc-card p-5 text-center group cursor-pointer" id={`agency-${agency.toLowerCase()}`}>
          <div class={`badge ${AGENCY_INFO[agency].badgeClass} mb-3 mx-auto`}>
            {AGENCY_INFO[agency].name}
          </div>
          <div class="text-xl font-display font-bold text-white mb-1 group-hover:text-cyan-bright transition-colors">{agencyCounts[agency]}</div>
          <div class="text-[10px] text-space-300 font-mono leading-relaxed">{AGENCY_INFO[agency].fullName}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="section-header">
      <h2 class="font-display text-lg md:text-xl font-bold text-white uppercase tracking-wider">Featured Documents</h2>
    </div>
    <p class="text-space-300 mb-8 text-sm font-mono">High-signal files from the PURSUE releases.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.slice(0, 6).map(doc => {
        const previewUrl = documentPreviewUrl(doc);
        const mainType = primaryFileType(doc);
        return (
        <a href={`/documents/${doc.slug}/`} class="doc-card group cursor-pointer" id={`featured-${doc.id}`}>
          {previewUrl ? (
            <div class="relative overflow-hidden rounded-t aspect-video bg-space-900 scanlines">
              <img 
                src={previewUrl}
                alt={doc.title}
                class="featured-thumb w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-space-950/45 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3">
                <span class={`badge ${AGENCY_INFO[doc.agency].badgeClass} text-[9px]`}>
                  {doc.agency}
                </span>
              </div>
            </div>
          ) : (
            <div class="relative overflow-hidden rounded-t aspect-video bg-space-900 scanlines flex items-center justify-center">
              <span class={`file-icon ${fileIconClass(mainType)} text-[9px]`}>{mainType.toUpperCase().slice(0, 3)}</span>
              <div class="absolute top-3 left-3">
                <span class={`badge ${AGENCY_INFO[doc.agency].badgeClass} text-[9px]`}>{doc.agency}</span>
              </div>
            </div>
          )}
          <div class="p-4">
            <h3 class="font-semibold text-white text-sm leading-snug mb-2 group-hover:text-cyan-bright transition-colors line-clamp-2">
              {doc.title}
            </h3>
            <div class="flex items-center gap-2 text-[10px] text-space-300 font-mono">
              <span>{CATEGORY_INFO[doc.category]?.label}</span>
              {doc.location && <span>· {doc.location.name}</span>}
            </div>
            <div class="flex items-center gap-2 mt-3">
              {doc.files.some(f => f.type === 'video') && <span class="file-icon file-icon-video text-[9px]">MP4</span>}
              {doc.files.some(f => f.type === 'audio') && <span class="file-icon file-icon-audio text-[9px]">AUD</span>}
              {doc.files.some(f => f.type === 'pdf') && <span class="file-icon file-icon-pdf text-[9px]">PDF</span>}
              {doc.files.some(f => f.type === 'image') && <span class="file-icon file-icon-image text-[9px]">IMG</span>}
            </div>
          </div>
        </a>
        );
      })}
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="flex items-center justify-between gap-6 mb-8">
      <div class="section-header flex-1">
        <h2 class="font-display text-lg md:text-xl font-bold text-white uppercase tracking-wider">Sample Records</h2>
      </div>
      <a href="/documents/" class="shrink-0 text-xs text-cyan-bright hover:text-white transition-colors font-mono tracking-wider uppercase">
        View All →
      </a>
    </div>

    <div class="space-y-2">
      {documents.slice(0, 8).map((doc, i) => (
        <a href={`/documents/${doc.slug}/`} class="doc-card flex items-center gap-4 p-3.5 group cursor-pointer" id={`doc-row-${i}`}>
          <div class="flex gap-1 shrink-0">
            {doc.files.some(f => f.type === 'video') && <span class="file-icon file-icon-video text-[9px]">VID</span>}
            {doc.files.some(f => f.type === 'audio') && <span class="file-icon file-icon-audio text-[9px]">AUD</span>}
            {doc.files.some(f => f.type === 'pdf') && <span class="file-icon file-icon-pdf text-[9px]">PDF</span>}
            {!doc.files.some(f => f.type === 'video') && !doc.files.some(f => f.type === 'audio') && !doc.files.some(f => f.type === 'pdf') && <span class="file-icon file-icon-image text-[9px]">IMG</span>}
          </div>

          <div class="flex-1 min-w-0">
            <h3 class="font-medium text-white text-sm group-hover:text-cyan-bright transition-colors truncate">
              {doc.title}
            </h3>
            <div class="flex flex-wrap items-center gap-2 text-[10px] text-space-300 mt-0.5 font-mono">
              <span class={`badge ${AGENCY_INFO[doc.agency].badgeClass} text-[8px] py-0 px-1.5`}>{doc.agency}</span>
              <span>{CATEGORY_INFO[doc.category]?.label}</span>
              {doc.location && <span>· {doc.location.name}</span>}
            </div>
          </div>

          <div class="hidden sm:block text-[10px] font-mono text-space-300 shrink-0">{doc.year}</div>
          <div class="hidden sm:block text-[10px] text-space-300 shrink-0 font-mono">{doc.files.length} file{doc.files.length > 1 ? 's' : ''}</div>
        </a>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href="/documents/" class="inline-flex items-center gap-2 px-6 py-2.5 border border-space-400/60 text-space-100 hover:text-white hover:border-cyan-glow/50 font-mono font-medium text-xs tracking-wider uppercase rounded transition-all">
        View All {totalDocs} Records →
      </a>
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="glass-panel p-8 md:p-12">
      <div class="section-header">
        <h2 class="font-display text-lg md:text-xl font-bold text-white uppercase tracking-wider">What is PURSUE?</h2>
      </div>
      <div class="prose prose-invert max-w-none text-space-100 space-y-4 text-sm">
        <p>
          The <strong class="text-white">Presidential Unsealing and Reporting System for UAP Encounters (PURSUE)</strong> is a U.S. government initiative launched on May 8, 2026.
        </p>
        <p>
          It directed agencies including the Department of War, FBI, NASA, State Department, and National Archives to identify, review, and declassify records related to <strong class="text-white">Unidentified Anomalous Phenomena (UAP)</strong>.
        </p>
        <p>
          This site turns the public release batches into a searchable archive, with direct routes into records, agencies, media coverage, and the release timeline.
        </p>
      </div>
    </div>
  </section>

  <style>
    @keyframes scanDown {
      from { top: -1px; }
      to { top: 100%; }
    }
  </style>
</BaseLayout>
