---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { documents } from '../../data/documents';
import { AGENCY_INFO, CATEGORY_INFO } from '../../data/types';
import { mediaUrl } from '../../config';

const allAgencies = [...new Set(documents.map(d => d.agency))];
const allCategories = [...new Set(documents.map(d => d.category))];
---
<BaseLayout title="Document Database" description="Browse all declassified UAP/UFO documents from the PURSUE initiative. Filter by agency, category, and year.">
  <section class="container-narrow py-12">
    <div class="mb-8">
      <span class="stamp-declassified mb-4">PURSUE ARCHIVE</span>
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white mt-4 mb-2 uppercase tracking-wider">Document Database</h1>
      <p class="text-space-400 text-sm font-mono">{documents.length} declassified documents from {allAgencies.length} agencies.</p>
    </div>

    <!-- Filter bar -->
    <div class="glass-panel p-4 mb-8 flex flex-wrap gap-2 items-center" id="filter-bar">
      <span class="text-[9px] font-mono text-space-500 uppercase tracking-[0.2em]">// filter:</span>
      {allAgencies.map(a => (
        <a href={`/agencies/${a.toLowerCase()}`} class={`badge ${AGENCY_INFO[a].badgeClass} hover:opacity-80 transition-opacity cursor-pointer`}>
          {a} ({documents.filter(d => d.agency === a).length})
        </a>
      ))}
    </div>

    <!-- Document grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {documents.map((doc, i) => (
        <a href={`/documents/${doc.slug}`} class="doc-card group fade-up cursor-pointer" style={`animation-delay: ${Math.min(i * 25, 400)}ms`} id={`doc-${doc.slug}`}>
          {doc.files.find(f => f.type === 'image') && (
            <div class="relative overflow-hidden rounded-t aspect-video bg-space-900 scanlines">
              <img 
                src={mediaUrl('image', doc.files.find(f => f.type === 'image')!.filename)}
                alt={doc.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-space-950/50 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3">
                <span class={`badge ${AGENCY_INFO[doc.agency].badgeClass} text-[9px]`}>{doc.agency}</span>
              </div>
              {doc.files.some(f => f.type === 'video') && (
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-10 h-10 rounded-full bg-space-950/70 flex items-center justify-center backdrop-blur-sm border border-cyan-glow/20">
                    <span class="text-cyan-bright text-sm ml-0.5">▶</span>
                  </div>
                </div>
              )}
            </div>
          )}
          <div class="p-4">
            <h3 class="font-semibold text-white text-sm leading-snug mb-2 group-hover:text-cyan-bright transition-colors line-clamp-2">
              {doc.title}
            </h3>
            <div class="flex items-center gap-2 text-[10px] text-space-400 font-mono">
              <span>{CATEGORY_INFO[doc.category]?.label}</span>
            </div>
            <div class="flex items-center justify-between mt-3">
              <div class="flex gap-1">
                {doc.files.some(f => f.type === 'video') && <span class="file-icon file-icon-video text-[8px]">▶</span>}
                {doc.files.some(f => f.type === 'pdf') && <span class="file-icon file-icon-pdf text-[8px]">PDF</span>}
                {doc.files.some(f => f.type === 'image') && <span class="file-icon file-icon-image text-[8px]">IMG</span>}
              </div>
              <span class="text-[10px] font-mono text-space-500">{doc.year}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
