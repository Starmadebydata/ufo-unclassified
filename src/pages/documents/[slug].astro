---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { documents } from '../../data/documents';
import { AGENCY_INFO, CATEGORY_INFO } from '../../data/types';
import { mediaUrl } from '../../config';

export function getStaticPaths() {
  return documents.map(doc => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const imageFiles = doc.files.filter((file: any) => file.type === 'image');
const videoFiles = doc.files.filter((file: any) => file.type === 'video');
const pdfFiles = doc.files.filter((file: any) => file.type === 'pdf');
const agencyInfo = AGENCY_INFO[doc.agency];
const categoryInfo = CATEGORY_INFO[doc.category];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = imageFiles[0] ? mediaUrl('image', imageFiles[0].filename) : '/og-default.png';
const citationDate = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date());
const answerBlock = `${doc.title} is a declassified ${categoryInfo?.label || 'UAP document'} from ${agencyInfo.fullName}. The record is dated ${doc.year}, was released on ${doc.dateReleased} under the PURSUE initiative, and contains ${doc.files.length} file${doc.files.length > 1 ? 's' : ''}${doc.location ? ` connected to ${doc.location.name}` : ''}.`;
const generatedFindings = [
  `Source agency: ${agencyInfo.fullName}.`,
  `Record category: ${categoryInfo?.label || 'Declassified record'}.`,
  `Release date: ${doc.dateReleased}.`,
  `File package: ${imageFiles.length} image${imageFiles.length === 1 ? '' : 's'}, ${videoFiles.length} video${videoFiles.length === 1 ? '' : 's'}, and ${pdfFiles.length} PDF${pdfFiles.length === 1 ? '' : 's'}.`,
];
const findings = doc.keyFindings.length > 0 ? doc.keyFindings : generatedFindings;
const citationText = `UFO Declassified. "${doc.title}." ${agencyInfo.fullName}, ${doc.year}. Released ${doc.dateReleased}. ${canonicalUrl}. Accessed ${citationDate}.`;
const relatedFromIds = doc.relatedDocs
  .map((id: string) => documents.find(candidate => candidate.id === id))
  .filter(Boolean);
const fallbackRelated = documents
  .filter(candidate => candidate.id !== doc.id && (candidate.agency === doc.agency || candidate.category === doc.category))
  .slice(0, 6);
const relatedDocs = [...relatedFromIds, ...fallbackRelated]
  .filter((candidate, index, array) => candidate && array.findIndex(item => item?.id === candidate.id) === index)
  .slice(0, 6);

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

function fileHref(file: any): string {
  return mediaUrl(file.type, file.filename);
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: doc.title,
  description: doc.summary,
  url: canonicalUrl,
  datePublished: doc.dateReleased,
  temporalCoverage: String(doc.year),
  genre: categoryInfo?.label,
  provider: {
    '@type': 'GovernmentOrganization',
    name: agencyInfo.fullName,
  },
  isPartOf: {
    '@type': 'Dataset',
    name: 'UFO Declassified PURSUE Document Archive',
    url: new URL('/documents', Astro.site).href,
  },
  associatedMedia: doc.files.map((file: any) => ({
    '@type': file.type === 'video' ? 'VideoObject' : file.type === 'image' ? 'ImageObject' : 'DigitalDocument',
    name: file.filename,
    contentUrl: fileHref(file),
    encodingFormat: file.type,
  })),
};
---
<BaseLayout 
  title={doc.title} 
  description={`Declassified ${categoryInfo?.label || 'document'} from ${agencyInfo.fullName}. Released ${doc.dateReleased} under PURSUE.${doc.location ? ` Location: ${doc.location.name}.` : ''}`}
  ogImage={ogImage}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="container-narrow py-12">
    <nav class="flex items-center gap-2 text-[10px] text-space-300 mb-6 font-mono tracking-wider uppercase">
      <a href="/" class="hover:text-cyan-bright transition-colors">Home</a>
      <span>/</span>
      <a href="/documents" class="hover:text-cyan-bright transition-colors">Documents</a>
      <span>/</span>
      <span class="text-space-100 truncate max-w-[240px]">{doc.title}</span>
    </nav>

    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class={`badge ${agencyInfo.badgeClass}`}>{agencyInfo.name}</span>
        <span class="badge badge-cyan">{categoryInfo?.label}</span>
        <span class="stamp-declassified text-[9px]">DECLASSIFIED</span>
      </div>

      <h1 class="font-display text-xl md:text-3xl font-bold text-white mb-4 leading-tight uppercase tracking-wide">{doc.title}</h1>

      <p class="max-w-4xl text-space-50 text-base leading-relaxed">{answerBlock}</p>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded border border-cyan-glow/18 bg-cyan-glow/10">
        {[
          { label: 'Agency', value: agencyInfo.fullName },
          { label: 'Record Year', value: doc.year },
          { label: 'Released', value: doc.dateReleased },
          { label: 'Files', value: `${doc.files.length} total` },
        ].map(item => (
          <div class="bg-space-900/95 p-5">
            <div class="text-[10px] font-mono uppercase tracking-[0.22em] text-space-300">{item.label}</div>
            <div class="mt-2 text-sm font-semibold text-white">{item.value}</div>
          </div>
        ))}
      </div>

      <div class="mt-5">
        <ShareButtons url={`/documents/${doc.slug}`} title={doc.title} description={doc.summary || answerBlock} />
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-8">
      <div class="space-y-10">
        <section class="glass-panel p-6 md:p-8">
          <div class="section-header">
            <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Citation-Ready Summary</h2>
          </div>
          <p class="text-space-50 text-sm md:text-base leading-relaxed">{answerBlock}</p>
          {doc.summary && <p class="mt-4 text-space-100 text-sm leading-relaxed">{doc.summary}</p>}
        </section>

        <section>
          <div class="section-header">
            <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Key Facts</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {findings.map((finding: string) => (
              <div class="doc-card p-4">
                <p class="text-sm leading-relaxed text-space-100">{finding}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <div class="section-header">
            <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Files in This Record</h2>
          </div>
          <div class="glass-panel overflow-hidden">
            <div class="grid grid-cols-[88px_minmax(0,1fr)_90px] gap-3 border-b border-cyan-glow/10 px-4 py-3 text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">
              <span>Type</span>
              <span>Filename</span>
              <span class="text-right">Size</span>
            </div>
            {doc.files.map((file: any, index: number) => (
              <a href={fileHref(file)} target="_blank" rel="noopener" class="grid grid-cols-[88px_minmax(0,1fr)_90px] gap-3 px-4 py-3 border-b border-cyan-glow/8 last:border-0 hover:bg-cyan-glow/5 transition-colors">
                <span class={`file-icon ${file.type === 'pdf' ? 'file-icon-pdf' : file.type === 'video' ? 'file-icon-video' : 'file-icon-image'} text-[8px]`}>{file.type.toUpperCase()}</span>
                <span class="min-w-0 truncate text-sm text-white">{file.filename}</span>
                <span class="text-right text-[10px] font-mono text-space-300">{formatBytes(file.size)}</span>
              </a>
            ))}
          </div>
        </section>

        {imageFiles.length > 0 && (
          <section>
            <div class="section-header">
              <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Image Preview ({imageFiles.length})</h2>
            </div>
            <div class={`grid gap-4 ${imageFiles.length === 1 ? 'grid-cols-1 max-w-3xl' : 'grid-cols-1 md:grid-cols-2'}`}>
              {imageFiles.map((file: any, i: number) => (
                <div class="doc-card overflow-hidden" id={`img-${i}`}>
                  <div class="scanlines border border-space-700/30">
                    <img
                      src={mediaUrl('image', file.filename)}
                      alt={`${doc.title} source image ${i + 1}`}
                      class="w-full h-auto max-h-[80vh] object-contain bg-space-900"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-3 flex items-center justify-between gap-4 text-[10px] text-space-300 font-mono">
                    <span class="truncate">{file.filename}</span>
                    <span>{formatBytes(file.size)}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {videoFiles.length > 0 && (
          <section>
            <div class="section-header">
              <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Video Preview ({videoFiles.length})</h2>
            </div>
            {videoFiles.map((file: any, i: number) => (
              <div class="doc-card overflow-hidden mb-4" id={`video-${i}`}>
                <video
                  controls
                  preload="metadata"
                  class="w-full"
                  poster={imageFiles[0] ? mediaUrl('image', imageFiles[0].filename) : undefined}
                >
                  <source src={mediaUrl('video', file.filename)} type="video/mp4" />
                </video>
                <div class="p-3 flex items-center justify-between gap-4 text-[10px] text-space-300 font-mono">
                  <span class="truncate">{file.filename}</span>
                  <span>{formatBytes(file.size)}</span>
                </div>
              </div>
            ))}
          </section>
        )}
      </div>

      <aside class="space-y-6">
        <section class="glass-panel p-5">
          <h2 class="font-display text-sm font-bold text-white uppercase tracking-wider">How to Cite</h2>
          <p class="mt-3 text-xs leading-relaxed text-space-100">{citationText}</p>
          <a href={canonicalUrl} class="mt-4 block truncate text-xs font-mono text-cyan-bright hover:text-white">{canonicalUrl}</a>
        </section>

        <section class="glass-panel p-5">
          <h2 class="font-display text-sm font-bold text-white uppercase tracking-wider">Source & Provenance</h2>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Original Release</dt>
              <dd class="mt-1 text-white">PURSUE first batch, May 8, 2026</dd>
            </div>
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Source Portal</dt>
              <dd class="mt-1"><a href="https://war.gov/UFO" target="_blank" rel="noopener">war.gov/UFO ↗</a></dd>
            </div>
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Archive Page</dt>
              <dd class="mt-1 text-white">UFO Declassified index record</dd>
            </div>
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Classification</dt>
              <dd class="mt-1 text-red-stamp font-mono font-bold">{doc.classification}</dd>
            </div>
          </dl>
        </section>

        <section class="glass-panel p-5">
          <h2 class="font-display text-sm font-bold text-white uppercase tracking-wider">Record Details</h2>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Category</dt>
              <dd class="mt-1 text-white">{categoryInfo?.label}</dd>
            </div>
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Agency</dt>
              <dd class="mt-1 text-white">{agencyInfo.fullName}</dd>
            </div>
            {doc.location && (
              <div>
                <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Location</dt>
                <dd class="mt-1 text-white">{doc.location.name}, {doc.location.region}</dd>
              </div>
            )}
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-space-300">Tags</dt>
              <dd class="mt-2 flex flex-wrap gap-2">
                {doc.tags.map((tag: string) => (
                  <span class="rounded border border-cyan-glow/20 bg-cyan-glow/5 px-2 py-1 text-[10px] font-mono text-cyan-bright">{tag}</span>
                ))}
              </dd>
            </div>
          </dl>
        </section>
      </aside>
    </div>

    {relatedDocs.length > 0 && (
      <section class="mt-12">
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Related Records</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {relatedDocs.map((related: any) => (
            <a href={`/documents/${related.slug}`} class="doc-card p-4 group cursor-pointer">
              <span class={`badge ${AGENCY_INFO[related.agency].badgeClass} text-[8px] mb-3`}>{related.agency}</span>
              <h3 class="text-sm text-white group-hover:text-cyan-bright transition-colors line-clamp-2 font-medium">{related.title}</h3>
              <p class="text-[10px] text-space-300 mt-2 font-mono">{CATEGORY_INFO[related.category]?.label} / {related.year}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
