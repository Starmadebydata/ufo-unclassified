---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { documents, getDocumentBySlug } from '../../data/documents';
import { AGENCY_INFO, CATEGORY_INFO } from '../../data/types';
import { mediaUrl } from '../../config';

export function getStaticPaths() {
  return documents.map(doc => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const imageFiles = doc.files.filter((f: any) => f.type === 'image');
const videoFiles = doc.files.filter((f: any) => f.type === 'video');
const pdfFiles = doc.files.filter((f: any) => f.type === 'pdf');
const agencyInfo = AGENCY_INFO[doc.agency];
const categoryInfo = CATEGORY_INFO[doc.category];

// Find related docs by same agency
const relatedDocs = documents
  .filter(d => d.agency === doc.agency && d.id !== doc.id)
  .slice(0, 4);

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}
---
<BaseLayout 
  title={doc.title} 
  description={`Declassified ${categoryInfo?.label || 'document'} from ${agencyInfo.fullName}. Released May 8, 2026 under PURSUE.${doc.location ? ` Location: ${doc.location.name}.` : ''}`}
>
  <article class="container-narrow py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-[10px] text-space-500 mb-6 font-mono tracking-wider uppercase">
      <a href="/" class="hover:text-cyan-bright transition-colors">Home</a>
      <span>/</span>
      <a href="/documents" class="hover:text-cyan-bright transition-colors">Documents</a>
      <span>/</span>
      <span class="text-space-300 truncate max-w-[200px]">{doc.title}</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class={`badge ${agencyInfo.badgeClass}`}>{agencyInfo.name}</span>
        <span class="badge" style="background: rgba(100,100,100,0.1); color: #8099cc; border: 1px solid rgba(100,100,100,0.2);">
          {categoryInfo?.label}
        </span>
        <span class="stamp-declassified text-[9px]">DECLASSIFIED</span>
      </div>

      <h1 class="font-display text-xl md:text-2xl font-bold text-white mb-3 leading-tight uppercase tracking-wide">{doc.title}</h1>
      
      <div class="flex flex-wrap gap-4 text-xs text-space-400 font-mono">
        {doc.location && (
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z"/></svg>
            {doc.location.name}{doc.location.region !== doc.location.name ? `, ${doc.location.region}` : ''}
          </span>
        )}
        <span>{doc.year}</span>
        <span>{doc.files.length} file{doc.files.length > 1 ? 's' : ''}</span>
        <span>{agencyInfo.fullName}</span>
      </div>

      {doc.summary && (
        <div class="glass-panel p-5 mt-4">
          <p class="text-space-200 text-sm leading-relaxed">{doc.summary}</p>
        </div>
      )}

      <div class="mt-5">
        <ShareButtons url={`/documents/${doc.slug}`} title={doc.title} description={doc.summary || `Declassified ${categoryInfo?.label || 'document'} from ${agencyInfo.fullName}`} />
      </div>
    </div>

    <div class="divider-glow mb-8"></div>

    <!-- Image viewer -->
    {imageFiles.length > 0 && (
      <section class="mb-10">
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Images ({imageFiles.length})</h2>
        </div>
        <div class={`grid gap-4 ${imageFiles.length === 1 ? 'grid-cols-1 max-w-3xl' : 'grid-cols-1 md:grid-cols-2'}`}>
          {imageFiles.map((file: any, i: number) => (
            <div class="doc-card overflow-hidden" id={`img-${i}`}>
              <div class="scanlines border border-space-700/30">
                <img 
                  src={mediaUrl('image', file.filename)}
                  alt={`${doc.title} - Image ${i + 1}`}
                  class="w-full h-auto max-h-[80vh] object-contain bg-space-900"
                  loading="lazy"
                />
              </div>
              <div class="p-3 flex items-center justify-between text-[10px] text-space-500 font-mono">
                <span class="truncate">{file.filename}</span>
                <span>{formatBytes(file.size)}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Video player -->
    {videoFiles.length > 0 && (
      <section class="mb-10">
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Videos ({videoFiles.length})</h2>
        </div>
        {videoFiles.map((file: any, i: number) => (
          <div class="doc-card overflow-hidden mb-4" id={`video-${i}`}>
            <video 
              controls 
              preload="metadata"
              class="w-full"
              poster={imageFiles[0] ? mediaUrl('image', imageFiles[0].filename) : undefined}
            >
              <source src={mediaUrl('video', file.filename)} type="video/mp4" />
            </video>
            <div class="p-3 flex items-center justify-between text-[10px] text-space-500 font-mono">
              <span class="truncate">{file.filename}</span>
              <span>{formatBytes(file.size)}</span>
            </div>
          </div>
        ))}
      </section>
    )}

    <!-- PDF links -->
    {pdfFiles.length > 0 && (
      <section class="mb-10">
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">PDF Documents ({pdfFiles.length})</h2>
        </div>
        {pdfFiles.map((file: any, i: number) => (
          <a href={mediaUrl('pdf', file.filename)} target="_blank" rel="noopener" class="doc-card flex items-center gap-4 p-4 mb-3 group cursor-pointer" id={`pdf-${i}`}>
            <span class="file-icon file-icon-pdf text-sm">PDF</span>
            <div class="flex-1 min-w-0">
              <span class="text-white group-hover:text-cyan-bright transition-colors font-medium text-sm truncate block">{file.filename}</span>
              <span class="text-[10px] text-space-500 font-mono">{formatBytes(file.size)}</span>
            </div>
            <span class="text-xs text-space-500 font-mono">Open ↗</span>
          </a>
        ))}
      </section>
    )}

    <!-- Document metadata -->
    <section class="mb-10">
      <div class="section-header">
        <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Document Details</h2>
      </div>
      <div class="glass-panel p-6">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-space-500 font-mono text-[10px] uppercase mb-1 tracking-wider">Source Agency</dt>
            <dd class="text-white text-sm">{agencyInfo.fullName}</dd>
          </div>
          <div>
            <dt class="text-space-500 font-mono text-[10px] uppercase mb-1 tracking-wider">Category</dt>
            <dd class="text-white text-sm">{categoryInfo?.label}</dd>
          </div>
          <div>
            <dt class="text-space-500 font-mono text-[10px] uppercase mb-1 tracking-wider">Document Year</dt>
            <dd class="text-white text-sm">{doc.year}</dd>
          </div>
          <div>
            <dt class="text-space-500 font-mono text-[10px] uppercase mb-1 tracking-wider">Released</dt>
            <dd class="text-white text-sm">{doc.dateReleased}</dd>
          </div>
          {doc.location && (
            <div>
              <dt class="text-space-500 font-mono text-[10px] uppercase mb-1 tracking-wider">Location</dt>
              <dd class="text-white text-sm">{doc.location.name}, {doc.location.region}</dd>
            </div>
          )}
          <div>
            <dt class="text-space-500 font-mono text-[10px] uppercase mb-1 tracking-wider">Classification</dt>
            <dd class="text-red-stamp font-mono font-bold text-sm">{doc.classification}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Related Documents -->
    {relatedDocs.length > 0 && (
      <section>
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Related Documents</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {relatedDocs.map(rd => (
            <a href={`/documents/${rd.slug}`} class="doc-card p-4 group cursor-pointer">
              <span class={`badge ${AGENCY_INFO[rd.agency].badgeClass} text-[8px] mb-2`}>{rd.agency}</span>
              <h3 class="text-xs text-white group-hover:text-cyan-bright transition-colors line-clamp-2 font-medium">{rd.title}</h3>
              <p class="text-[10px] text-space-500 mt-1 font-mono">{rd.year}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
