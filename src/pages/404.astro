---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not Found" description="The page you are looking for does not exist or has been moved.">
  <section class="container-narrow py-20 md:py-32 max-w-2xl mx-auto text-center">
    <div class="mb-6">
      <span class="font-mono text-[10px] tracking-[0.3em] uppercase text-cyan-glow/60">error // 404</span>
    </div>
    <h1 class="font-display text-4xl md:text-6xl font-bold text-white uppercase tracking-wider mb-6">
      Signal Lost
    </h1>
    <p class="text-space-300 text-sm md:text-base leading-relaxed mb-8 max-w-md mx-auto">
      The page you are looking for has been declassified, moved, or never existed in this archive.
      Return to the main terminal to continue your search.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/" class="inline-flex items-center gap-2 px-6 py-2.5 bg-cyan-glow/90 hover:bg-cyan-bright text-space-950 font-mono font-bold text-xs tracking-wider uppercase rounded transition-all">
        ← Return Home
      </a>
      <a href="/documents/" class="inline-flex items-center gap-2 px-6 py-2.5 border border-cyan-glow/30 hover:border-cyan-glow/60 text-space-200 hover:text-cyan-bright font-mono font-bold text-xs tracking-wider uppercase rounded transition-all">
        Browse Documents
      </a>
    </div>
  </section>
</BaseLayout>
