---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id)
  .filter(p => p.data.tags.some(t => post.data.tags.includes(t)))
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.ogImage ? [post.data.ogImage] : undefined,
  datePublished: post.data.date,
  dateModified: post.data.updated || post.data.date,
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: 'https://ufo-declassified.com/about/flynn-lin',
  },
  publisher: {
    '@type': 'Organization',
    name: 'UFO Declassified',
    url: 'https://ufo-declassified.com',
  },
};
---
<BaseLayout 
  title={post.data.title} 
  description={post.data.description}
  ogImage={post.data.ogImage}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <article class="container-narrow py-12 max-w-3xl mx-auto">
    {/* Header */}
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <a href="/blog/" class="text-[10px] font-mono text-space-500 hover:text-cyan-bright transition-colors tracking-wider uppercase">← All Articles</a>
      </div>
      <div class="flex items-center gap-2 mb-4">
        <span class="badge badge-cyan text-[9px]">{post.data.category}</span>
        {post.data.featured && <span class="badge badge-amber text-[9px]">FEATURED</span>}
        {post.data.readingTime && (
          <span class="text-[10px] font-mono text-space-500">{post.data.readingTime}</span>
        )}
      </div>
      <h1 class="font-display text-xl md:text-3xl font-bold text-white leading-tight mb-4 uppercase tracking-wide">
        {post.data.title}
      </h1>
      <p class="text-space-300 text-sm leading-relaxed mb-5">
        {post.data.description}
      </p>
      <div class="flex items-center gap-4 text-[10px] text-space-500 mb-4 font-mono tracking-wider">
        <span>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>by <a href="/about/flynn-lin/" class="text-cyan-bright hover:underline">{post.data.author}</a></span>
      </div>
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map(tag => (
          <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-space-900/80 text-space-400 border border-space-700/50">{tag}</span>
        ))}
      </div>
      <div class="mt-5">
        <ShareButtons url={`/blog/${post.id}/`} title={post.data.title} description={post.data.description} />
      </div>
      <div class="divider-glow my-6"></div>
    </header>

    {post.data.ogImage && (
      <figure class="article-hero-image scanlines mb-10">
        <img src={post.data.ogImage} alt={`${post.data.title} cover image`} loading="eager" />
      </figure>
    )}

    {/* Article Body */}
    <div class="article-body prose prose-invert prose-lg max-w-none
      prose-headings:font-display prose-headings:text-white prose-headings:font-bold prose-headings:uppercase prose-headings:tracking-wider
      prose-h2:text-lg prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-space-700/50 prose-h2:pb-2
      prose-h3:text-base prose-h3:mt-8 prose-h3:mb-3
      prose-h4:text-sm prose-h4:mt-6 prose-h4:mb-2
      prose-p:text-space-200 prose-p:leading-relaxed prose-p:text-[14px]
      prose-a:text-cyan-bright prose-a:no-underline hover:prose-a:underline
      prose-strong:text-white
      prose-li:text-space-200 prose-li:text-[14px]
      prose-table:text-sm
      prose-th:text-space-300 prose-th:font-semibold prose-th:text-left prose-th:px-3 prose-th:py-2 prose-th:bg-space-800 prose-th:border-space-700
      prose-td:text-space-200 prose-td:px-3 prose-td:py-2 prose-td:border-space-700/50
      prose-hr:border-space-700
      prose-blockquote:border-cyan-500/50 prose-blockquote:bg-space-800/30 prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:text-space-300
      prose-code:text-cyan-bright prose-code:bg-space-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-xs prose-code:font-mono
    ">
      <Content />
    </div>

    {/* Related Posts */}
    {relatedPosts.length > 0 && (
      <div class="mt-16">
        <div class="divider-glow mb-8"></div>
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Related Articles</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {relatedPosts.map(rp => (
            <a href={`/blog/${rp.id}/`} class="doc-card p-4 group cursor-pointer">
              <span class="badge badge-cyan text-[8px] mb-2">{rp.data.category}</span>
              <h3 class="text-xs font-semibold text-white group-hover:text-cyan-bright transition-colors line-clamp-2">{rp.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Bottom Share Bar */}
    <div class="mt-12 mb-8">
      <div class="divider-glow mb-6"></div>
      <div class="flex items-center justify-between flex-wrap gap-4">
        <p class="text-space-500 text-xs font-mono">Found this useful? Share it with others.</p>
        <ShareButtons url={`/blog/${post.id}/`} title={post.data.title} description={post.data.description} variant="inline" />
      </div>
    </div>

    {/* Newsletter */}
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>

    {/* CTA */}
    <div class="glass-panel p-6 text-center">
      <p class="text-space-400 text-xs mb-4 font-mono">Explore the full archive of declassified UAP documents</p>
      <a href="/documents/" class="inline-flex items-center gap-2 px-6 py-2.5 bg-cyan-glow/90 hover:bg-cyan-bright text-space-950 font-mono font-bold text-xs tracking-wider uppercase rounded transition-all">Browse All Documents →</a>
    </div>
  </article>
</BaseLayout>
