---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featured = posts.filter(p => p.data.featured);
const regular = posts.filter(p => !p.data.featured);
---
<BaseLayout title="Blog & Analysis" description="In-depth analysis, guides, and commentary on declassified UAP/UFO documents from the PURSUE initiative.">
  <section class="container-narrow py-12">
    <div class="mb-10">
      <span class="stamp-declassified mb-4">INTELLIGENCE BRIEFING</span>
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white mt-4 mb-2 uppercase tracking-wider">Analysis & Guides</h1>
      <p class="text-space-400 max-w-2xl text-sm font-mono">In-depth research, expert analysis, and comprehensive guides to help you understand the declassified UAP documents released under the PURSUE initiative.</p>
    </div>

    {/* Featured Posts */}
    {featured.length > 0 && (
      <div class="mb-12">
        {featured.map(post => (
          <a href={`/blog/${post.id}/`} class="block doc-card group p-0 overflow-hidden radar-sweep cursor-pointer" id={`featured-${post.id}`}>
            {post.data.ogImage && (
              <div class="relative aspect-[16/7] overflow-hidden bg-space-900 scanlines">
                <img
                  src={post.data.ogImage}
                  alt={post.data.title}
                  class="featured-thumb h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-space-950/75 via-space-950/10 to-transparent"></div>
              </div>
            )}
            <div class="p-6 md:p-8">
              <div class="flex items-center gap-2 mb-4">
                <span class="badge badge-amber text-[9px]">FEATURED</span>
                <span class="badge badge-cyan text-[9px]">{post.data.category}</span>
                {post.data.readingTime && (
                  <span class="text-[10px] font-mono text-space-500">{post.data.readingTime}</span>
                )}
              </div>
              <h2 class="font-display text-lg md:text-xl font-bold text-white group-hover:text-cyan-bright transition-colors mb-3 leading-tight uppercase tracking-wide">
                {post.data.title}
              </h2>
              <p class="text-space-400 text-xs leading-relaxed mb-4 max-w-3xl font-mono">
                {post.data.description}
              </p>
              <div class="flex items-center gap-4 text-[10px] text-space-500 font-mono tracking-wider">
                <span>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                <span>by {post.data.author}</span>
              </div>
              <div class="flex gap-2 mt-4">
                {post.data.tags.slice(0, 5).map(tag => (
                  <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-space-900/80 text-space-400 border border-space-700/50">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

    {/* All Posts Grid */}
    {regular.length > 0 && (
      <div>
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">All Articles</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {regular.map(post => (
            <a href={`/blog/${post.id}/`} class="doc-card group cursor-pointer overflow-hidden" id={`post-${post.id}`}>
              {post.data.ogImage && (
                <div class="relative aspect-video overflow-hidden bg-space-900 scanlines">
                  <img
                    src={post.data.ogImage}
                    alt={post.data.title}
                    class="featured-thumb h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-space-950/55 via-transparent to-transparent"></div>
                </div>
              )}
              <div class="p-5">
                <div class="flex items-center gap-2 mb-3">
                  <span class="badge badge-cyan text-[9px]">{post.data.category}</span>
                  {post.data.readingTime && (
                    <span class="text-[10px] font-mono text-space-500">{post.data.readingTime}</span>
                  )}
                </div>
                <h3 class="font-semibold text-white text-sm leading-snug mb-2 group-hover:text-cyan-bright transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-space-400 text-xs leading-relaxed mb-3 line-clamp-3 font-mono">
                  {post.data.description}
                </p>
                <span class="text-[10px] font-mono text-space-500 tracking-wider">
                  {new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {posts.length === 0 && (
      <div class="glass-panel p-8 text-center">
        <p class="text-space-400 font-mono text-sm">No articles published yet. Check back soon.</p>
      </div>
    )}
  </section>
</BaseLayout>
