---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { documents } from '../../data/documents';
import { AGENCY_INFO, CATEGORY_INFO } from '../../data/types';
import type { Agency } from '../../data/types';

export function getStaticPaths() {
  return (Object.keys(AGENCY_INFO) as Agency[])
    .filter(key => documents.some(d => d.agency === key))
    .map(key => ({
      params: { agency: key.toLowerCase() },
      props: { agencyKey: key },
    }));
}

const { agencyKey } = Astro.props;
const agency = AGENCY_INFO[agencyKey as Agency];
const agencyDocs = documents.filter(d => d.agency === agencyKey);
---
<BaseLayout title={`${agency.fullName} Documents`} description={`Browse ${agencyDocs.length} declassified UAP documents from the ${agency.fullName}.`}>
  <section class="container-narrow py-12">
    <nav class="flex items-center gap-2 text-sm text-space-400 mb-6">
      <a href="/" class="hover:text-white">Home</a><span>/</span>
      <a href="/agencies" class="hover:text-white">Agencies</a><span>/</span>
      <span class="text-space-200">{agency.name}</span>
    </nav>

    <div class="flex items-center gap-4 mb-8">
      <span class={`badge ${agency.badgeClass} text-base py-1.5 px-4`}>{agency.name}</span>
      <div>
        <h1 class="font-display text-2xl md:text-3xl font-bold text-white">{agency.fullName}</h1>
        <p class="text-space-300">{agencyDocs.length} declassified documents</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {agencyDocs.map(doc => (
        <a href={`/documents/${doc.slug}`} class="doc-card group">
          {doc.files.find(f => f.type === 'image') && (
            <div class="relative overflow-hidden rounded-t-xl aspect-video bg-space-800 scanlines">
              <img src={`/source-files/image/${doc.files.find(f => f.type === 'image')!.filename}`} alt={doc.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy"/>
              <div class="absolute top-3 left-3">
                <span class={`badge ${agency.badgeClass} text-[10px]`}>{agency.name}</span>
              </div>
            </div>
          )}
          <div class="p-4">
            <h3 class="font-semibold text-white text-sm leading-snug mb-2 group-hover:text-cyan-bright transition-colors line-clamp-2">{doc.title}</h3>
            <div class="flex items-center justify-between text-xs text-space-400">
              <span>{CATEGORY_INFO[doc.category]?.label}</span>
              <span class="font-mono">{doc.year}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
