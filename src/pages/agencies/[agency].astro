---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { documents } from '../../data/documents';
import { AGENCY_INFO, CATEGORY_INFO } from '../../data/types';
import type { Agency } from '../../data/types';
import { fileThumbnailUrl } from '../../config';

export function getStaticPaths() {
  return (Object.keys(AGENCY_INFO) as Agency[])
    .filter(key => documents.some(d => d.agency === key))
    .map(key => ({
      params: { agency: key.toLowerCase() },
      props: { agencyKey: key },
    }));
}

const { agencyKey } = Astro.props;
const agency = AGENCY_INFO[agencyKey as Agency];
const agencyDocs = documents.filter(d => d.agency === agencyKey);

function documentPreviewUrl(doc: any): string | undefined {
  const imageFile = doc.files.find((file: any) => file.type === 'image');
  if (imageFile) return fileThumbnailUrl(imageFile);
  const mediaFile = doc.files.find((file: any) => (file.type === 'video' || file.type === 'audio') && file.thumbnailUrl);
  return mediaFile ? fileThumbnailUrl(mediaFile) : undefined;
}

function primaryFileType(doc: any): string {
  if (doc.files.some((file: any) => file.type === 'video')) return 'video';
  if (doc.files.some((file: any) => file.type === 'audio')) return 'audio';
  if (doc.files.some((file: any) => file.type === 'pdf')) return 'pdf';
  return 'image';
}

function fileIconClass(type: string): string {
  if (type === 'pdf') return 'file-icon-pdf';
  if (type === 'video') return 'file-icon-video';
  if (type === 'audio') return 'file-icon-audio';
  return 'file-icon-image';
}
---
<BaseLayout title={`${agency.fullName} Documents`} description={`Browse ${agencyDocs.length} declassified UAP documents from the ${agency.fullName}.`}>
  <section class="container-narrow py-12">
    <nav class="flex items-center gap-2 text-[10px] text-space-500 mb-6 font-mono tracking-wider uppercase">
      <a href="/" class="hover:text-cyan-bright transition-colors">Home</a><span>/</span>
      <a href="/agencies/" class="hover:text-cyan-bright transition-colors">Agencies</a><span>/</span>
      <span class="text-space-300">{agency.name}</span>
    </nav>

    <div class="flex items-center gap-4 mb-8">
      <span class={`badge ${agency.badgeClass} text-sm py-1.5 px-4`}>{agency.name}</span>
      <div>
        <h1 class="font-display text-xl md:text-2xl font-bold text-white uppercase tracking-wider">{agency.fullName}</h1>
        <p class="text-space-400 text-xs font-mono">{agencyDocs.length} declassified documents</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {agencyDocs.map(doc => {
        const previewUrl = documentPreviewUrl(doc);
        const mainType = primaryFileType(doc);
        return (
        <a href={`/documents/${doc.slug}/`} class="doc-card group cursor-pointer">
          {previewUrl ? (
            <div class="relative overflow-hidden rounded-t aspect-video bg-space-900 scanlines">
              <img src={previewUrl} alt={doc.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy"/>
              <div class="absolute inset-0 bg-gradient-to-t from-space-950/50 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3">
                <span class={`badge ${agency.badgeClass} text-[9px]`}>{agency.name}</span>
              </div>
            </div>
          ) : (
            <div class="relative overflow-hidden rounded-t aspect-video bg-space-900 scanlines flex items-center justify-center">
              <span class={`file-icon ${fileIconClass(mainType)} text-[9px]`}>{mainType.toUpperCase().slice(0, 3)}</span>
              <div class="absolute top-3 left-3">
                <span class={`badge ${agency.badgeClass} text-[9px]`}>{agency.name}</span>
              </div>
            </div>
          )}
          <div class="p-4">
            <h3 class="font-semibold text-white text-sm leading-snug mb-2 group-hover:text-cyan-bright transition-colors line-clamp-2">{doc.title}</h3>
            <div class="flex items-center justify-between text-[10px] text-space-400 font-mono">
              <span>{doc.releaseLabel || 'Release 01'} / {CATEGORY_INFO[doc.category]?.label}</span>
              <span>{doc.year}</span>
            </div>
          </div>
        </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
