---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { documents } from '../../data/documents';
import { AGENCY_INFO } from '../../data/types';
import type { Agency } from '../../data/types';

const agencies = (Object.keys(AGENCY_INFO) as Agency[]).map(key => ({
  ...AGENCY_INFO[key],
  key,
  count: documents.filter(d => d.agency === key).length,
})).filter(a => a.count > 0);
---
<BaseLayout title="Agencies" description="Browse declassified UAP documents by source agency: Department of War, FBI, NASA, DOE, CIA, ODNI, State Department, and National Archives.">
  <section class="container-narrow py-12">
    <div class="section-header">
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white uppercase tracking-wider">Source Agencies</h1>
    </div>
    <p class="text-space-400 mb-10 text-sm font-mono">Documents organized by the U.S. government agency or source group that released them.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {agencies.map(agency => (
        <a href={`/agencies/${agency.key.toLowerCase()}/`} class="doc-card p-6 group radar-sweep cursor-pointer" id={`agency-card-${agency.key}`}>
          <div class="flex items-start justify-between mb-4">
            <span class={`badge ${agency.badgeClass} text-sm`}>{agency.name}</span>
            <span class="text-2xl font-display font-bold text-white group-hover:text-cyan-bright transition-colors">{agency.count}</span>
          </div>
          <h2 class="text-base font-semibold text-white group-hover:text-cyan-bright transition-colors mb-2">{agency.fullName}</h2>
          <p class="text-xs text-space-400 font-mono">{agency.count} declassified documents available.</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
