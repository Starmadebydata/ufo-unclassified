---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { documents } from '../../data/documents';
import { AGENCY_INFO, CATEGORY_INFO } from '../../data/types';
import { archiveTopics, getTopicBySlug } from '../../data/topics';
import { fileThumbnailUrl, makeArchiveDatasetSchema } from '../../config';

export function getStaticPaths() {
  return archiveTopics.map(topic => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;

const topicSpotlights: Record<string, Array<{ href: string; label: string; title: string; body: string }>> = {
  'nasa-apollo-ufo-material': [
    {
      href: '/documents/nasa-uap-d1-apollo-12-transcript-1969/',
      label: 'Apollo 12 transcript',
      title: 'Apollo 12 Mission Transcript',
      body: 'The primary NASA transcript page for Apollo 12 communications and anomalous-observation context.',
    },
    {
      href: '/documents/nasa-uap-vm1-apollo-12-1969/',
      label: 'Apollo 12 UFO files',
      title: 'Apollo 12 Visual Media',
      body: 'The entry point for the Apollo 12 lunar image set selected into the UAP release.',
    },
    {
      href: '/documents/nasa-uap-d2-apollo-17-transcript-1972/',
      label: 'Apollo 17 transcript',
      title: 'Apollo 17 Mission Transcript',
      body: 'NASA transcript context for Apollo 17 anomalous-light and UAP searches.',
    },
    {
      href: '/documents/nasa-uap-vm6-apollo-17-1972/',
      label: 'Apollo 17 UAP',
      title: 'Apollo 17 Visual Media VM6',
      body: 'The Apollo 17 image record to compare with transcript and crew debriefing material.',
    },
    {
      href: '/blog/apollo-12-lunar-anomaly-field-guide/',
      label: 'Field guide',
      title: 'How to Read the Apollo Files',
      body: 'A guided reading path for comparing Apollo 12 images, transcript records, and Apollo 17 material.',
    },
  ],
  'fbi-ufo-files': [
    {
      href: '/documents/65-hs1-834228961-62-hq-83894-section-10/',
      label: '65-HS1 834228961',
      title: 'FBI 62-HQ-83894 Section 10',
      body: 'A high-demand FBI case-file page with public image and PDF files.',
    },
    {
      href: '/documents/65-hs1-834228961-62-hq-83894-section-7/',
      label: '62-HQ-83894',
      title: 'FBI 62-HQ-83894 Section 7',
      body: 'A companion section in the same FBI file series for cross-checking adjacent records.',
    },
    {
      href: '/blog/fbi-physical-evidence-photo-lab/',
      label: 'Photo evidence',
      title: 'FBI Physical Evidence Guide',
      body: 'A reader-friendly guide to the FBI photo and case-file records in the archive.',
    },
  ],
  'pentagon-uap-videos': [
    {
      href: '/documents/1006106-dow-uap-pr46-unresolved-uap-report-indopacom-2024/',
      label: 'DOW-UAP-PR46',
      title: 'PR46 INDOPACOM 2024',
      body: 'The public source page for the INDOPACOM unresolved UAP video record.',
    },
    {
      href: '/documents/1006073-dow-uap-pr28-unresolved-uap-report-greece-january-2024/',
      label: 'DOW-UAP-PR28',
      title: 'PR28 Greece 2024',
      body: 'The public source page for the Greece January 2024 unresolved UAP video record.',
    },
    {
      href: '/documents/2024-04-30-composite-sketch/',
      label: 'Composite sketch',
      title: 'April 30, 2024 Sketch',
      body: 'The composite sketch record that appears in recent search demand.',
    },
  ],
};

const spotlightItems = topicSpotlights[topic.slug] || [];

function topicMatches(slug: string, doc: any): boolean {
  const title = doc.title.toLowerCase();
  const tags = doc.tags.join(' ').toLowerCase();
  if (slug === 'pursue-release-2026') return doc.dateReleased.startsWith('2026-');
  if (slug === 'pursue-release-05') return (doc.releaseLabel || 'Release 01') === 'Release 05';
  if (slug === 'pursue-release-04') return (doc.releaseLabel || 'Release 01') === 'Release 04';
  if (slug === 'pursue-release-03') return (doc.releaseLabel || 'Release 01') === 'Release 03';
  if (slug === 'pursue-release-02') return (doc.releaseLabel || 'Release 01') === 'Release 02';
  if (slug === 'fbi-ufo-files') return doc.agency === 'FBI';
  if (slug === 'nasa-apollo-ufo-material') return doc.agency === 'NASA' || title.includes('apollo') || tags.includes('apollo');
  if (slug === 'pentagon-uap-videos') return doc.agency === 'DOW' || doc.files.some((file: any) => file.type === 'video');
  if (slug === 'historical-flying-disc-records') return doc.year <= 1963 || title.includes('flying disc') || title.includes('flying discs');
  return false;
}

const matchingDocs = documents.filter(doc => topicMatches(topic.slug, doc));
const totalFiles = matchingDocs.reduce((sum, doc) => sum + doc.files.length, 0);
const agencyCount = new Set(matchingDocs.map(doc => doc.agency)).size;
const years = [...new Set(matchingDocs.map(doc => doc.year))].sort((a, b) => a - b);
const yearRange = years.length ? `${years[0]}-${years[years.length - 1]}` : 'N/A';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const topicSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: topic.title,
  description: topic.answer,
  url: canonicalUrl,
  isPartOf: makeArchiveDatasetSchema(Astro.site),
  about: matchingDocs.slice(0, 12).map(doc => ({
    '@type': 'CreativeWork',
    name: doc.title,
    url: new URL(`/documents/${doc.slug}`, Astro.site).href,
  })),
};

function documentPreviewUrl(doc: any): string | undefined {
  const imageFile = doc.files.find((file: any) => file.type === 'image');
  if (imageFile) return fileThumbnailUrl(imageFile);
  const mediaFile = doc.files.find((file: any) => (file.type === 'video' || file.type === 'audio') && file.thumbnailUrl);
  return mediaFile ? fileThumbnailUrl(mediaFile) : undefined;
}

function primaryFileType(doc: any): string {
  if (doc.files.some((file: any) => file.type === 'video')) return 'video';
  if (doc.files.some((file: any) => file.type === 'audio')) return 'audio';
  if (doc.files.some((file: any) => file.type === 'pdf')) return 'pdf';
  return 'image';
}

function fileIconClass(type: string): string {
  if (type === 'pdf') return 'file-icon-pdf';
  if (type === 'video') return 'file-icon-video';
  if (type === 'audio') return 'file-icon-audio';
  return 'file-icon-image';
}
---
<BaseLayout title={topic.title} description={topic.description}>
  <script type="application/ld+json" set:html={JSON.stringify(topicSchema)} />

  <section class="container-narrow py-12">
    <nav class="flex items-center gap-2 text-[10px] text-space-300 mb-6 font-mono tracking-wider uppercase">
      <a href="/" class="hover:text-cyan-bright transition-colors">Home</a>
      <span>/</span>
      <a href="/topics/" class="hover:text-cyan-bright transition-colors">Topics</a>
      <span>/</span>
      <span class="text-space-100 truncate max-w-[240px]">{topic.shortTitle}</span>
    </nav>

    <div class="section-header">
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white uppercase tracking-wider">{topic.title}</h1>
    </div>

    <div class="glass-panel p-6 md:p-8">
      <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-cyan-bright mb-3">Direct Answer</div>
      <p class="text-space-50 text-base leading-relaxed">{topic.answer}</p>
    </div>

    {spotlightItems.length > 0 && (
      <div class="mt-6">
        <div class="section-header">
          <h2 class="font-display text-base font-bold text-white uppercase tracking-wider">Common Search Paths</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {spotlightItems.map(item => (
            <a href={item.href} class="doc-card p-4 group cursor-pointer">
              <div class="text-[10px] font-mono uppercase tracking-[0.18em] text-amber-bright">{item.label}</div>
              <h3 class="mt-3 text-sm font-semibold text-white group-hover:text-cyan-bright transition-colors">{item.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-space-200">{item.body}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="status-strip mt-6 grid grid-cols-1 sm:grid-cols-4 gap-px overflow-hidden rounded border border-cyan-glow/18 bg-cyan-glow/10">
      <div class="bg-space-900/95 p-5">
        <div class="text-[10px] font-mono uppercase tracking-[0.22em] text-space-300">Selection Rule</div>
        <div class="mt-2 text-sm font-semibold text-white">{topic.criteriaLabel}</div>
      </div>
      <div class="bg-space-900/95 p-5">
        <div class="text-[10px] font-mono uppercase tracking-[0.22em] text-space-300">Records</div>
        <div class="mt-2 font-display text-lg font-bold text-white">{matchingDocs.length}</div>
      </div>
      <div class="bg-space-900/95 p-5">
        <div class="text-[10px] font-mono uppercase tracking-[0.22em] text-space-300">Files</div>
        <div class="mt-2 font-display text-lg font-bold text-white">{totalFiles}</div>
      </div>
      <div class="bg-space-900/95 p-5">
        <div class="text-[10px] font-mono uppercase tracking-[0.22em] text-space-300">Years</div>
        <div class="mt-2 font-display text-lg font-bold text-white">{yearRange}</div>
      </div>
    </div>
  </section>

  <section class="container-narrow pb-16">
    <div class="section-header">
      <h2 class="font-display text-lg md:text-xl font-bold text-white uppercase tracking-wider">Records in This Topic</h2>
    </div>
    <p class="mb-8 text-sm font-mono text-space-300">Showing {matchingDocs.length} records across {agencyCount} source group{agencyCount === 1 ? '' : 's'}.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {matchingDocs.map(doc => {
        const previewUrl = documentPreviewUrl(doc);
        const mainType = primaryFileType(doc);
        return (
        <a href={`/documents/${doc.slug}/`} class="doc-card group cursor-pointer">
          {previewUrl ? (
            <div class="relative overflow-hidden rounded-t aspect-video bg-space-900 scanlines">
              <img
                src={previewUrl}
                alt={doc.title}
                class="featured-thumb w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-space-950/45 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3">
                <span class={`badge ${AGENCY_INFO[doc.agency].badgeClass} text-[9px]`}>{doc.agency}</span>
              </div>
            </div>
          ) : (
            <div class="relative overflow-hidden rounded-t aspect-video bg-space-900 scanlines flex items-center justify-center">
              <span class={`file-icon ${fileIconClass(mainType)} text-[9px]`}>{mainType.toUpperCase().slice(0, 3)}</span>
              <div class="absolute top-3 left-3">
                <span class={`badge ${AGENCY_INFO[doc.agency].badgeClass} text-[9px]`}>{doc.agency}</span>
              </div>
            </div>
          )}
          <div class="p-4">
            <h3 class="font-semibold text-white text-sm leading-snug mb-2 group-hover:text-cyan-bright transition-colors line-clamp-2">{doc.title}</h3>
            <p class="text-xs leading-relaxed text-space-200 line-clamp-3">{doc.summary}</p>
            <div class="mt-3 flex flex-wrap items-center gap-2 text-[10px] text-space-300 font-mono">
              <span>{doc.releaseLabel || 'Release 01'}</span>
              <span>{CATEGORY_INFO[doc.category]?.label}</span>
              <span>{doc.year}</span>
              <span>{doc.files.length} file{doc.files.length > 1 ? 's' : ''}</span>
            </div>
          </div>
        </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
